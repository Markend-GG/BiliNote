diff --git a/backend/app/services/cleanup_service.py b/backend/app/services/cleanup_service.py
new file mode 100644
index 0000000..a5b1d80
--- /dev/null
+++ b/backend/app/services/cleanup_service.py
@@ -0,0 +1,188 @@
+"""孤儿截图的自动清理：按天数 + 按孤儿总量两条规则，定时在后台跑。
+
+两条规则都只在「孤儿集合」里生效——候选集由 library_service.scan_storage() 给出，
+它只列没有任何笔记引用（清单 ∪ 正则都查不到）的文件，所以笔记里的正常截图
+从一开始就不在候选里，不是靠阈值挡住的。真正的删除动作复用
+delete_orphan_screenshots()，删除前会再算一次引用，期间被新笔记引用的会自动跳过。
+
+策略与上次执行结果存 config/storage_cleanup.json（与 proxy.json 同一套约定，
+config 是独立卷，重建容器不丢）。keep_days / max_orphan_mb 填 0 表示关掉对应那条规则。
+"""
+
+import json
+import os
+import threading
+import time
+from pathlib import Path
+
+from app.services import library_service
+from app.utils.logger import get_logger
+
+logger = get_logger(__name__)
+
+# 测试里会被重绑到临时目录，所以每次用都重新取模块属性，别在 import 期固化成 Path
+POLICY_PATH = os.getenv("STORAGE_CLEANUP_CONFIG", "config/storage_cleanup.json")
+
+# 首次延迟：避开启动时的回填/模型加载；之后每 24 小时一次
+INITIAL_DELAY_SECONDS = 90
+INTERVAL_SECONDS = 24 * 3600
+
+DEFAULTS = {"enabled": True, "keep_days": 14, "max_orphan_mb": 800}
+
+_started = False
+_lock = threading.Lock()
+
+
+def _read_raw() -> dict:
+    path = Path(POLICY_PATH)
+    if not path.is_file():
+        return {}
+    try:
+        return json.loads(path.read_text(encoding="utf-8"))
+    except Exception as e:
+        # 配置坏了不该让接口 500，退回默认值，下一次保存会覆盖掉坏文件
+        logger.warning(f"读取自动清理配置失败，用默认值: {e}")
+        return {}
+
+
+def _write_raw(data: dict) -> None:
+    path = Path(POLICY_PATH)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
+
+
+def load_policy() -> dict:
+    raw = _read_raw()
+    policy = dict(DEFAULTS)
+    for key in DEFAULTS:
+        if key in raw:
+            policy[key] = raw[key]
+    policy["enabled"] = bool(policy["enabled"])
+    policy["keep_days"] = max(0, int(policy["keep_days"] or 0))
+    policy["max_orphan_mb"] = max(0, int(policy["max_orphan_mb"] or 0))
+    return policy
+
+
+def save_policy(patch: dict) -> dict:
+    """局部更新策略。写文件时保留 last_run，别把执行记录冲掉。"""
+    policy = load_policy()
+    if "enabled" in patch:
+        policy["enabled"] = bool(patch["enabled"])
+    if "keep_days" in patch:
+        policy["keep_days"] = max(0, int(patch["keep_days"] or 0))
+    if "max_orphan_mb" in patch:
+        policy["max_orphan_mb"] = max(0, int(patch["max_orphan_mb"] or 0))
+    raw = _read_raw()
+    raw.update(policy)
+    _write_raw(raw)
+    logger.info(
+        f"自动清理策略已更新：enabled={policy['enabled']} keep_days={policy['keep_days']} "
+        f"max_orphan_mb={policy['max_orphan_mb']}"
+    )
+    return policy
+
+
+def get_status() -> dict:
+    return {"policy": load_policy(), "last_run": _read_raw().get("last_run")}
+
+
+def run_auto_cleanup(reason: str = "schedule") -> dict:
+    """跑一次自动清理。reason=schedule 时尊重开关，manual（界面上点按钮）总是执行。"""
+    policy = load_policy()
+    if reason == "schedule" and not policy["enabled"]:
+        return {"skipped": "disabled", "deleted": 0, "freed_bytes": 0}
+
+    scan = library_service.scan_storage()
+    orphans = scan.get("orphans") or []
+    now_ms = int(time.time() * 1000)
+
+    aged, kept = [], []
+    if policy["keep_days"] > 0:
+        cutoff = now_ms - policy["keep_days"] * 86400 * 1000
+        for item in orphans:
+            (aged if item["mtime"] < cutoff else kept).append(item)
+    else:
+        kept = list(orphans)
+
+    # 容量规则算的是「孤儿总量」，不是截图目录总量：被引用的截图既不计数也不参与删除
+    over_cap = []
+    cap_bytes = policy["max_orphan_mb"] * 1024 * 1024
+    if cap_bytes > 0:
+        excess = sum(item["size"] for item in kept) - cap_bytes
+        if excess > 0:
+            for item in sorted(kept, key=lambda x: x["mtime"]):  # 最旧的先走
+                over_cap.append(item)
+                excess -= item["size"]
+                if excess <= 0:
+                    break
+
+    targets = aged + over_cap
+    size_by_name = {item["name"]: item["size"] for item in targets}
+    result = (
+        library_service.delete_orphan_screenshots(list(size_by_name))
+        if size_by_name
+        else {"deleted": [], "skipped": []}
+    )
+    deleted = result["deleted"]
+    freed = sum(size_by_name.get(name, 0) for name in deleted)
+
+    remaining = [o for o in orphans if o["name"] not in set(deleted)]
+    stats = {
+        "at": now_ms,
+        "reason": reason,
+        "aged_deleted": len([n for n in deleted if n in {i["name"] for i in aged}]),
+        "over_cap_deleted": len([n for n in deleted if n in {i["name"] for i in over_cap}]),
+        "deleted": len(deleted),
+        "skipped": len(result["skipped"]),
+        "freed_bytes": freed,
+        "remaining_orphans": len(remaining),
+        "remaining_orphan_bytes": sum(o["size"] for o in remaining),
+        "policy": policy,
+    }
+
+    raw = _read_raw()
+    raw.update(policy)
+    raw["last_run"] = stats
+    try:
+        _write_raw(raw)
+    except Exception as e:
+        logger.warning(f"写入自动清理记录失败: {e}")
+
+    if deleted:
+        logger.info(
+            f"自动清理孤儿截图（{reason}）：删除 {len(deleted)} 张、释放 {freed / 1048576:.1f}MB，"
+            f"其中超期 {stats['aged_deleted']} 张、超容量 {stats['over_cap_deleted']} 张；"
+            f"剩余孤儿 {stats['remaining_orphans']} 张 / {stats['remaining_orphan_bytes'] / 1048576:.1f}MB"
+        )
+    else:
+        logger.info(
+            f"自动清理孤儿截图（{reason}）：无需清理，剩余孤儿 {stats['remaining_orphans']} 张"
+        )
+    return stats
+
+
+def _loop() -> None:
+    time.sleep(INITIAL_DELAY_SECONDS)
+    while True:
+        try:
+            run_auto_cleanup("schedule")
+        except Exception as e:
+            # 后台线程里抛异常会静默死掉，之后再也不清理，必须兜住
+            logger.error(f"自动清理失败: {e}", exc_info=True)
+        time.sleep(INTERVAL_SECONDS)
+
+
+def start_scheduler() -> bool:
+    """启动后台清理线程（幂等）。在 main.py 的 lifespan 里调用。"""
+    global _started
+    with _lock:
+        if _started:
+            return False
+        _started = True
+    policy = load_policy()
+    logger.info(
+        f"孤儿截图自动清理已启动：enabled={policy['enabled']} keep_days={policy['keep_days']} "
+        f"max_orphan_mb={policy['max_orphan_mb']}，首次 {INITIAL_DELAY_SECONDS}s 后执行、之后每 24h 一次"
+    )
+    threading.Thread(target=_loop, name="orphan-cleanup", daemon=True).start()
+    return True
diff --git a/backend/app/services/library_service.py b/backend/app/services/library_service.py
new file mode 100644
index 0000000..779bcd0
--- /dev/null
+++ b/backend/app/services/library_service.py
@@ -0,0 +1,327 @@
+"""笔记库的落地操作：删除一篇笔记的全部产物、启动时回填历史笔记索引。
+
+放在 service 层而不是 router 里，是因为 routers/note.py（删除单篇）和
+routers/library.py（删文件夹时连带删笔记）都要用，放任一边都会造成互相 import。
+"""
+
+import json
+import os
+import re
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+from app.db import library_dao, search_dao, video_task_dao
+from app.utils.logger import get_logger
+
+logger = get_logger(__name__)
+
+NOTE_OUTPUT_DIR = os.getenv("NOTE_OUTPUT_DIR", "note_results")
+IMAGE_OUTPUT_DIR = Path(os.getenv("OUT_DIR", "./static/screenshots"))
+VECTOR_DB_DIR = os.getenv("VECTOR_DB_DIR", "vector_db")
+
+# 截图文件名形如 screenshot_003_<uuid4>.jpg（utils/video_helper.py:22），uuid4 保证全局唯一，
+# 所以能靠 markdown 里的引用反查某篇笔记拥有哪些截图。
+_SCREENSHOT_NAME_RE = re.compile(r"screenshot_\d{3}_[0-9a-fA-F-]{36}\.jpg")
+# note_results 下只有 {task_id}.json 是"一篇笔记"，其余带下划线的都是派生缓存
+_NOTE_FILE_RE = re.compile(r"^[0-9a-fA-F-]{36}\.json$")
+
+# 生成一篇笔记时截图是先落盘的，note json 要等总结写完才有——中间这几分钟里，
+# 新截图在引用集里查不到，会被判成孤儿。给一个宽限期，别把正在生成的笔记的图列出来让人删。
+_ORPHAN_GRACE_MS = 30 * 60 * 1000
+
+
+def _within_grace(mtime_ms: float, now_ms: float) -> bool:
+    """宽限期关掉（<=0）时一律返回 False，测试才能确定性地验引用逻辑本身。"""
+    return _ORPHAN_GRACE_MS > 0 and now_ms - mtime_ms < _ORPHAN_GRACE_MS
+
+# 一篇笔记在 note_results 下的全部文件。
+# _markdown.status.json 是历史遗留：早期有个 bug 会把 SUMMARIZING 状态写到这个文件名上，
+# 现有数据里确实存在，删除时一并清掉。
+_NOTE_FILE_SUFFIXES = (
+    ".json",
+    ".status.json",
+    "_audio.json",
+    "_transcript.json",
+    "_markdown.md",
+    "_markdown.status.json",
+)
+
+
+def _referenced_screenshots(note_data: dict) -> set[str]:
+    """从笔记 markdown 里摘出它引用的截图文件名（只要 basename，防路径穿越）。"""
+    markdown = note_data.get("markdown", "") or ""
+    return set(_SCREENSHOT_NAME_RE.findall(markdown))
+
+
+def _unlink(path: Path) -> bool:
+    try:
+        if path.is_file():
+            path.unlink()
+            return True
+    except OSError as e:
+        logger.warning(f"删除文件失败 {path}: {e}")
+    return False
+
+
+def delete_note_artifacts(task_id: str) -> dict:
+    """删掉一篇笔记在磁盘、SQLite、向量库里的全部痕迹。
+
+    任何一步失败只记日志、继续删其余的，最后返回实际删除计数——
+    删到一半就抛异常会留下更难以清理的残骸。
+    """
+    deleted_files = 0
+    deleted_screenshots = 0
+
+    note_path = Path(NOTE_OUTPUT_DIR) / f"{task_id}.json"
+    referenced: set[str] = set()
+    if note_path.is_file():
+        try:
+            with open(note_path, "r", encoding="utf-8") as f:
+                payload = json.load(f)
+            # 清单为主（生成时写下的真实引用），正则兜底（老笔记/清单被编辑过的情况）。
+            # 清单内容不可信程度等同于用户输入：必须过一遍文件名形态校验，防路径穿越
+            manifest = payload.get("screenshots")
+            if isinstance(manifest, list):
+                referenced.update(
+                    name for name in manifest
+                    if isinstance(name, str) and _SCREENSHOT_NAME_RE.fullmatch(name)
+                )
+            referenced.update(_referenced_screenshots(payload))
+        except Exception as e:
+            logger.warning(f"读取笔记 json 失败，跳过截图清理 {task_id}: {e}")
+
+    for suffix in _NOTE_FILE_SUFFIXES:
+        if _unlink(Path(NOTE_OUTPUT_DIR) / f"{task_id}{suffix}"):
+            deleted_files += 1
+
+    for name in referenced:
+        target = IMAGE_OUTPUT_DIR / name
+        # 双保险：正则已经限定了文件名形态，这里再确认解析后仍在截图目录内
+        if target.resolve().is_relative_to(IMAGE_OUTPUT_DIR.resolve()) and _unlink(target):
+            deleted_screenshots += 1
+
+    try:
+        video_task_dao.delete_by_task_id(task_id)
+    except Exception as e:
+        logger.warning(f"删除 video_tasks 记录失败 {task_id}: {e}")
+
+    library_dao.delete_note_row(task_id)
+
+    try:
+        search_dao.delete_note(task_id)
+    except Exception as e:
+        logger.warning(f"删除全文索引失败 {task_id}: {e}")
+
+    try:
+        from app.services.vector_store import VectorStoreManager
+
+        VectorStoreManager().delete_index(task_id)
+    except Exception as e:
+        logger.warning(f"删除向量索引失败 {task_id}: {e}")
+
+    logger.info(
+        f"已删除笔记 {task_id}：文件 {deleted_files} 个，截图 {deleted_screenshots} 张"
+    )
+    return {"deleted_files": deleted_files, "deleted_screenshots": deleted_screenshots}
+
+
+def _fts_missing(task_id: str) -> bool:
+    try:
+        return search_dao.count_note(task_id) == 0
+    except Exception:
+        # 索引表本身有问题时别在启动路径上刷一堆日志，搜索接口自己会报错
+        return False
+
+
+def _reindex_from_file(path: Path, task_id: str) -> bool:
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except Exception as e:
+        logger.warning(f"补建全文索引时读取失败 {path.name}: {e}")
+        return False
+    try:
+        search_dao.rebuild_note(task_id, data.get("markdown", "") or "")
+        return True
+    except Exception as e:
+        logger.warning(f"补建全文索引失败 {task_id}: {e}")
+        return False
+
+
+def backfill_library() -> int:
+    """启动时把 note_results/ 里已有但没进 notes 表的笔记补进去。
+
+    这是"清浏览器缓存也能找回历史"的兜底：以前历史列表完全依赖浏览器 IndexedDB，
+    盘上的 json 没有任何接口能列出来。幂等，失败不阻断启动。
+    """
+    note_dir = Path(NOTE_OUTPUT_DIR)
+    if not note_dir.is_dir():
+        return 0
+
+    existing = {n["task_id"] for n in library_dao.list_notes()}
+    added = 0
+    reindexed = 0
+    for path in sorted(note_dir.iterdir()):
+        if not _NOTE_FILE_RE.match(path.name):
+            continue
+        task_id = path.stem
+        if task_id in existing:
+            # 库里已经有了，但可能是"全文索引这个功能上线之前"就进来的：那批笔记在
+            # note_fts 里一行都没有，搜索永远搜不到它们。缺索引才读 json，补建一次
+            if _fts_missing(task_id) and _reindex_from_file(path, task_id):
+                reindexed += 1
+            continue
+        try:
+            with open(path, "r", encoding="utf-8") as f:
+                data = json.load(f)
+        except Exception as e:
+            logger.warning(f"回填时读取失败，跳过 {path.name}: {e}")
+            continue
+
+        meta = data.get("audio_meta") or {}
+        raw = meta.get("raw_info") or {}
+        # 老笔记没有 screenshots 清单：按 markdown 反查补写一次（幂等）。
+        # 之后删除笔记、清理孤儿截图都以清单为准，反查只作兜底
+        if not isinstance(data.get("screenshots"), list):
+            data["screenshots"] = sorted(_SCREENSHOT_NAME_RE.findall(data.get("markdown", "") or ""))
+            try:
+                with open(path, "w", encoding="utf-8") as f:
+                    json.dump(data, f, ensure_ascii=False, indent=2)
+            except Exception as e:
+                logger.warning(f"回填截图清单失败 {path.name}: {e}")
+        mtime = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc).replace(tzinfo=None)
+        library_dao.upsert_note(
+            task_id,
+            video_title=meta.get("title"),
