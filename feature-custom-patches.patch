+# BiliNote 浏览器冒烟测试
+
+独立于前端包（不进 Docker 构建、不动 pnpm-lock）。用系统已装的 Edge，不下载 Playwright 浏览器。
+
+```bash
+cd e2e
+npm install          # 只装 @playwright/test
+npm test             # 对着 http://localhost 跑（先确保容器在跑）
+```
+
+headless 页面的 visibilityState 是 visible，所以 scroll-spy、smooth 滚动这些
+"后台标签页验不了"的用例在这里能真跑。环境变量：E2E_BASE_URL、E2E_CHANNEL（默认 msedge，可改 chrome）。
diff --git a/e2e/global-setup.ts b/e2e/global-setup.ts
new file mode 100644
index 0000000..161a123
--- /dev/null
+++ b/e2e/global-setup.ts
@@ -0,0 +1,29 @@
+import { request, type FullConfig } from '@playwright/test'
+
+/**
+ * 等后端真的就绪再开跑。
+ *
+ * 容器刚重建时固定 sleep 十几秒是不够的：实测过一次前两个用例假失败、后面 9 个直接没跑，
+ * 单独重跑又全过。与其把 sleep 猜得越来越大，不如轮询一个真接口直到 200。
+ */
+export default async function globalSetup(config: FullConfig) {
+  const baseURL = config.projects[0]?.use?.baseURL || 'http://localhost'
+  const ctx = await request.newContext({ baseURL })
+  const deadline = Date.now() + 120_000
+  let lastError = 'unknown'
+  while (Date.now() < deadline) {
+    try {
+      const res = await ctx.get('/api/library', { timeout: 5000 })
+      if (res.ok()) {
+        await ctx.dispose()
+        return
+      }
+      lastError = `HTTP ${res.status()}`
+    } catch (e: any) {
+      lastError = e?.message || String(e)
+    }
+    await new Promise(resolve => setTimeout(resolve, 2000))
+  }
+  await ctx.dispose()
+  throw new Error(`后端 120 秒内没有就绪（${baseURL}/api/library）：${lastError}`)
+}
