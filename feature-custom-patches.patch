+
+class TestLinkifyToc(unittest.TestCase):
+    def test_plain_items_become_anchor_links(self):
+        markdown = (
+            "## 目录\n"
+            "- 0. 引入与题型定位\n"
+            "- AI 总结\n\n"
+            "## 0. 引入与题型定位\n\n正文\n\n"
+            "## AI 总结\n\n结尾\n"
+        )
+        result = linkify_toc(markdown)
+        self.assertIn("- [0. 引入与题型定位](#0-引入与题型定位)", result)
+        self.assertIn("- [AI 总结](#ai-总结)", result)
