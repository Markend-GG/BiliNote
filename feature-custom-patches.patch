+import { defineConfig } from '@playwright/test'
+
+// 用系统已装的 Edge（channel），不下载 Playwright 自带浏览器。
+// headless 页面的 visibilityState 是 visible，所以 scroll-spy / smooth 滚动这些
+// "后台标签页验不了"的用例在这里能真跑。
+export default defineConfig({
+  testDir: './tests',
+  timeout: 60_000,
+  retries: 0,
+  globalSetup: './global-setup.ts',
+  // 单 worker：每个用例都要渲染两三万字的笔记，3 个 worker 并跑时 CPU 争用会让
+  // scroll-spy 这类"滚动后等高亮变化"的用例偶发超时（单跑 3.9s 过、并跑挂）。
+  // 整套 14 例串行也只要 45 秒左右，确定性比这点时间值钱。
+  workers: 1,
+  use: {
+    baseURL: process.env.E2E_BASE_URL || 'http://localhost',
+    channel: process.env.E2E_CHANNEL || 'msedge',
+    headless: true,
+  },
+})
diff --git a/e2e/tests/features.spec.ts b/e2e/tests/features.spec.ts
new file mode 100644
index 0000000..30ee4cb
--- /dev/null
+++ b/e2e/tests/features.spec.ts
@@ -0,0 +1,108 @@
+import { test, expect } from '@playwright/test'
+
+// 覆盖 V3.2/V3.3 的交互项。依赖真实数据的地方都先取 /api/library，没数据就 skip。
+let taskId = ''
+let title = ''
+
+test.beforeAll(async ({ request }) => {
+  const res = await request.get('/api/library')
+  const notes = (await res.json()).data.notes
+  if (notes.length) {
+    taskId = notes[0].task_id
+    title = notes[0].title || notes[0].video_title || ''
+  }
+})
+
+test('设置→存储与清理页能扫描并列出占用', async ({ page }) => {
+  await page.goto('/settings/storage')
+  // 左侧导航里也有"存储与清理"这一项，不限定 main 会撞 strict mode
+  await expect(page.getByRole('main').getByText('存储与清理')).toBeVisible()
+  await expect(page.getByText('截图目录')).toBeVisible()
+  await expect(page.getByText('AI 问答向量索引')).toBeVisible()
+  // 孤儿区要么是清单要么是"很干净"
+  await expect(page.getByText(/孤儿截图（\d+）|没有孤儿截图/).first()).toBeVisible()
+})
+
+test('书架正文搜索命中并可跳转', async ({ page }) => {
+  test.skip(!taskId, '没有笔记数据')
+  await page.goto('/')
+  await page.fill('input[placeholder="搜索全部笔记…"]', '基期')
+  await expect(page.getByText(/正文命中 \d+ 条/)).toBeVisible({ timeout: 8000 })
+  await page.getByText(/正文命中 \d+ 条/).locator('..').getByRole('button').first().click()
+  await expect(page).toHaveURL(/\/note\//)
+  await expect(page.locator('.markdown-body')).toBeVisible()
+})
+
+test('排序偏好持久化', async ({ page }) => {
+  await page.goto('/')
+  await page.locator('button[aria-label="排序方式"]').click()
+  await page.getByRole('menuitem', { name: '时长最长' }).click()
+  await page.reload()
+  await expect(page.locator('button[aria-label="排序方式"]')).toContainText('时长最长')
+  // 还原，别把用户的偏好留在测试状态里
+  await page.locator('button[aria-label="排序方式"]').click()
+  await page.getByRole('menuitem', { name: '最新创建' }).click()
+})
+
+test('顶栏直接可见编辑/思维导图/收起全部', async ({ page }) => {
+  test.skip(!taskId, '没有笔记数据')
+  await page.goto(`/note/${taskId}`)
+  await expect(page.getByRole('button', { name: /^编辑/ })).toBeVisible()
+  await expect(page.getByRole('button', { name: /思维导图|返回笔记/ })).toBeVisible()
+  await expect(page.getByRole('button', { name: /收起全部|展开全部/ })).toBeVisible()
+})
+
+test('复制视频链接会出 toast', async ({ context, page }) => {
+  test.skip(!taskId, '没有笔记数据')
+  await context.grantPermissions(['clipboard-read', 'clipboard-write'])
+  await page.goto(`/note/${taskId}`)
+  await page.locator('button[aria-label="更多操作"]').click()
+  await page.getByRole('menuitem', { name: '复制视频链接' }).click()
+  await expect(page.getByText('已复制视频链接')).toBeVisible({ timeout: 5000 })
+})
+
+test('导出 HTML 触发下载', async ({ page }) => {
+  test.skip(!taskId, '没有笔记数据')
+  await page.goto(`/note/${taskId}`)
+  await page.locator('button[aria-label="更多操作"]').click()
+  const [download] = await Promise.all([
+    page.waitForEvent('download', { timeout: 20000 }),
+    page.getByRole('menuitem', { name: /导出 HTML/ }).click(),
+  ])
+  expect(download.suggestedFilename()).toMatch(/\.html$/)
+})
+
+test('点转写行会把正文滚到对应章节', async ({ page }) => {
+  test.skip(!taskId, '没有笔记数据')
+  await page.goto(`/note/${taskId}`)
+  await page.getByRole('button', { name: '原文参照' }).click()
+  await expect(page.getByRole('tablist')).toBeVisible()
+  const vp = page.locator('[data-radix-scroll-area-viewport]').first()
+  const before = await vp.evaluate(el => el.scrollTop)
+  // 必须点靠后的一条：章节胶囊的时间分布因笔记而异，点第 30 行可能映射到开头章节，
+  // 正文本来就在顶部，scrollTop 前后都是 0（换一篇笔记就假失败）。最后一条一定在后段。
+  await page.getByRole('tabpanel').locator('div.grid').last().click()
+  await expect
+    .poll(() => vp.evaluate(el => el.scrollTop), { timeout: 8000 })
+    .toBeGreaterThan(before)
+})
+
+test('存储页能改自动清理策略并立即执行', async ({ page }) => {
+  await page.goto('/settings/storage')
+  const main = page.getByRole('main')
+  await expect(main.getByText('自动清理孤儿截图')).toBeVisible()
+  // 开关默认开着；策略存到服务端后刷新页面要还在
+  await expect(main.getByLabel('启用自动清理')).toBeVisible()
+  await main.getByLabel('保留天数').fill('14')
+  await main.getByLabel('孤儿总量上限 MB').fill('800')
+  await main.getByRole('button', { name: '保存设置' }).click()
+  await expect(page.getByText('自动清理设置已保存')).toBeVisible()
+
+  await page.reload()
+  await expect(main.getByLabel('保留天数')).toHaveValue('14')
+  await expect(main.getByLabel('孤儿总量上限 MB')).toHaveValue('800')
+
+  // 手动触发一次：14 天 / 800MB 的阈值下现存孤儿都不满足条件，所以断言"跑过并留下记录"而不是删除数量
+  await main.getByRole('button', { name: '立即清理一次' }).click()
+  await expect(main.getByText(/上次清理：/)).toBeVisible({ timeout: 30000 })
+})
diff --git a/e2e/tests/note.spec.ts b/e2e/tests/note.spec.ts
new file mode 100644
index 0000000..734c8c3
--- /dev/null
+++ b/e2e/tests/note.spec.ts
@@ -0,0 +1,117 @@
+import { test, expect } from '@playwright/test'
+
+let taskId = ''
+
+test.beforeAll(async ({ request }) => {
+  const res = await request.get('/api/library')
+  const notes = (await res.json()).data.notes
+  if (!notes.length) test.skip()
+  taskId = notes[0].task_id
+})
+
+test('章节导航列出全部小节且滚动高亮跟随', async ({ page }) => {
+  await page.goto(`/note/${taskId}`)
+  const aside = page.locator('aside')
+  await expect(aside).toBeVisible()
+  const entries = aside.locator('button[title]')
+  await expect(entries.first()).toBeVisible()
+  expect(await entries.count()).toBeGreaterThan(3)
+
+  const before = await aside.locator('button[aria-current="location"]').getAttribute('title')
+  await page.evaluate(() => {
+    const vp = document
+      .querySelector('.markdown-body')!
+      .closest('[data-radix-scroll-area-viewport]') as HTMLElement
+    vp.scrollTop = vp.scrollHeight * 0.6
+  })
+  // scroll-spy 是 80ms 节流 + 渲染后再量位置，重笔记下 700ms 死等会偶发超时；轮询等到变为止
+  await expect
+    .poll(() => aside.locator('button[aria-current="location"]').getAttribute('title'), {
+      timeout: 8000,
+    })
+    .not.toBe(before)
+})
+
+test('打开参照 dock 时章节栏收竖条，关闭后恢复', async ({ page }) => {
+  await page.goto(`/note/${taskId}`)
+  // dock 面板是常驻挂载的，关掉只是 collapse 到 0 宽（内容被 overflow:hidden 裁掉）。
+  // 所以不能断言 tablist "hidden"：它有 px-2 内边距，自身盒子始终 16x40，Playwright 会判可见
+  const dockPanel = page.locator('[data-panel-id]', {
+    has: page.locator('[aria-label="参照面板"]'),
+  })
+  const dockWidth = async () => (await dockPanel.boundingBox())?.width ?? -1
+
+  expect(await dockWidth()).toBe(0)
+  await expect(page.locator('aside')).toBeVisible()
+
+  await page.getByRole('button', { name: '原文参照' }).click()
+  await expect.poll(dockWidth, { timeout: 5000 }).toBeGreaterThan(200)
+  await expect(page.locator('button[aria-label="展开章节导航"]')).toBeVisible()
+
+  await page.getByRole('button', { name: '原文参照' }).click()
+  await expect.poll(dockWidth, { timeout: 5000 }).toBe(0)
+  await expect(page.locator('aside')).toBeVisible()
+})
+
+test('窄屏下 dock 是浮层且带关闭按钮', async ({ page }) => {
+  await page.setViewportSize({ width: 1000, height: 800 })
+  await page.goto(`/note/${taskId}`)
+  await expect(page.locator('button[aria-label="展开章节导航"]')).toBeVisible()
+  await page.getByRole('button', { name: '原文参照' }).click()
+  // 窄屏是条件挂载的浮层，关掉就整个从 DOM 里消失，这里断言 hidden 是对的
+  await expect(page.getByRole('tablist')).toBeVisible()
+  await page.locator('button[aria-label="关闭参照面板"]').click()
+  await expect(page.getByRole('tablist')).toBeHidden()
+})
+
+test('生成中的流程页有返回书架的出口', async ({ page }) => {
+  // 伪造一个"生成中"的任务：拦截笔记库与状态接口，不碰真实数据、也不会真跑一次生成。
+  // 回归的是用户明确提的问题——流程页以前没有任何返回入口，人被卡在这一页只能刷新或按
+  // 浏览器后退，很自然会以为任务没成功、回去再新建一次（同一视频就被生成两遍）。
+  const fakeId = 'e2e11111-2222-4222-8222-222222222222'
+  const now = Date.now()
+  await page.route('**/api/library', route =>
+    route.fulfill({
+      json: {
+        code: 0,
+        msg: 'success',
+        data: {
+          folders: [],
+          notes: [
+            {
+              task_id: fakeId,
+              title: null,
+              video_title: '生成中的测试任务',
+              folder_id: null,
+              status: 'PENDING',
+              video_id: 'BV1test',
+              platform: 'bilibili',
+              cover_url: '',
+              duration: 0,
+              created_at: now,
+              updated_at: now,
+              last_opened_at: null,
+              form_data: { video_url: 'https://www.bilibili.com/video/BV1test', platform: 'bilibili' },
+            },
+          ],
+        },
+      },
+    }),
+  )
+  await page.route(`**/api/task_status/${fakeId}`, route =>
+    route.fulfill({
+      json: {
+        code: 0,
+        msg: 'success',
+        data: { status: 'PENDING', message: '任务排队中', task_id: fakeId },
+      },
+    }),
+  )
+
+  await page.goto(`/note/${fakeId}`)
+  await expect(page.getByText(/请稍候/)).toBeVisible({ timeout: 10000 })
+  const back = page.getByRole('button', { name: '返回书架' })
+  await expect(back).toBeVisible()
+  await back.click()
+  await expect(page).toHaveURL(/\/$/)
+})
diff --git a/e2e/tests/shelf.spec.ts b/e2e/tests/shelf.spec.ts
new file mode 100644
index 0000000..e8d3845
--- /dev/null
+++ b/e2e/tests/shelf.spec.ts
@@ -0,0 +1,71 @@
+import { test, expect } from '@playwright/test'
+
+test('书架页渲染卡片与新建入口', async ({ page }) => {
+  await page.goto('/')
+  await expect(page.getByRole('button', { name: '新建笔记' })).toBeVisible()
+  await expect(page.getByRole('button', { name: /全部/ })).toBeVisible()
+})
+
+test('新建文件夹对话框可开可关', async ({ page }) => {
+  await page.goto('/')
+  await page.getByRole('button', { name: '新建文件夹' }).click()
+  const dialog = page.locator('[data-slot="dialog-content"][data-state="open"]')
+  await expect(dialog).toBeVisible()
+  await expect(dialog.getByRole('textbox')).toBeVisible()
+  await page.keyboard.press('Escape')
+  await expect(dialog).toBeHidden()
+})
+
+test('列表/卡片视图切换', async ({ page }) => {
+  await page.goto('/')
+  await page.locator('button[aria-label="列表视图"]').click()
+  await expect(page.locator('main img.h-12').first()).toBeVisible()
+  await page.locator('button[aria-label="卡片视图"]').click()
+  await expect(page.locator('main .aspect-video').first()).toBeVisible()
+})
+
+test('新建笔记双击也只发一次提交请求', async ({ page }) => {
+  // 拦截提交：既数得清发了几次，又不会真启动一次生成（那要烧 API 额度、跑好几分钟）。
+  // 回归的是真实事故：一次点击发出两个相差 0.5ms 的请求 → 后端并发跑两份下载 →
+  // 其中一份 rename .part 失败 → 书架上多一条"生成失败"，用户以为没成功又点一次。
+  const posts: unknown[] = []
+  await page.route('**/api/generate_note', async route => {
+    posts.push(route.request().postDataJSON())
+    await route.fulfill({
+      status: 200,
+      contentType: 'application/json',
+      body: JSON.stringify({
+        code: 0,
+        msg: 'success',
+        data: { task_id: 'e2e00000-1111-4111-8111-111111111111' },
+      }),
+    })
+  })
+
+  await page.goto('/')
+  await page.getByRole('button', { name: '新建笔记' }).click()
+  const dialog = page.locator('[data-slot="dialog-content"][data-state="open"]')
+  await expect(dialog).toBeVisible()
+  await dialog
+    .getByPlaceholder('请输入视频网站链接')
+    .fill('https://www.bilibili.com/video/BV1e2e000E2gQ')
+
+  const submit = dialog.getByRole('button', { name: /生成笔记/ })
+  await expect(submit).toBeEnabled()
+  // 双击 = 用户着急时的真实行为。防重锁必须是同步的 ref：react-hook-form 的校验是异步的，
+  // 靠 setState 上锁的话第二次点击会赶在重渲染之前溜进去
+  await submit.dblclick()
+  await page.waitForTimeout(2000)
+
+  if (posts.length === 0) {
+    // 一次都没发出去 = 卡在校验或前端异常，把对话框现状打出来，否则只看到 0 != 1 没法定位
+    const text = (await dialog.innerText()).replace(/\n+/g, ' | ').slice(0, 700)
+    throw new Error(`没有发出提交请求。对话框内容：${text}`)
+  }
+  expect(posts.length, `双击发出了 ${posts.length} 次提交请求`).toBe(1)
+
+  // 提交完留在书架（不把人锁进流程页），并且立刻多出一张"生成中"的卡片
+  await expect(page).toHaveURL(/\/$/)
+  await expect(dialog).toBeHidden()
+  await expect(page.getByText(/排队中|生成中/).first()).toBeVisible({ timeout: 8000 })
+})
