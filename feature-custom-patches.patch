+
+def drop_screenshot_marker(markdown: str, marker: str) -> str:
+    """删掉一个截图标记；独占一行时连整行删除，免得笔记里留下空行。"""
+    lines = markdown.split("\n")
+    for i, line in enumerate(lines):
+        if marker not in line:
