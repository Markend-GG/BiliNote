+
+/** 后端 snippet 用 \x01/\x02 包命中词；切分后自己渲染 <mark>，绝不把摘要当 HTML 插入 */
+function renderSnippet(snippet: string) {
+  return snippet.split('\x01').map((part, i) => {
+    const [text, hit] = part.split('\x02')
+    return (
+      <span key={i}>
+        {text}
+        {hit !== undefined && <mark className="rounded-sm bg-yellow-200 px-0.5">{hit}</mark>}
+      </span>
+    )
+  })
+}
+
+function FilterChip({
+  label,
+  count,
+  active,
+  onClick,
+  onDropNote,
+}: {
+  label: string
+  count: number
+  active: boolean
+  onClick: () => void
+  /** 给了就是拖拽落点：把笔记卡拖到 chip 上直接归档，不用先滚到文件夹卡片那里 */
+  onDropNote?: (taskId: string) => void
+}) {
+  const [dragOver, setDragOver] = useState(false)
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      onDragOver={
+        onDropNote
+          ? e => {
+              if (!e.dataTransfer.types.includes(NOTE_DRAG_MIME)) return
+              e.preventDefault()
+              e.dataTransfer.dropEffect = 'move'
+              setDragOver(true)
+            }
+          : undefined
+      }
+      onDragLeave={onDropNote ? () => setDragOver(false) : undefined}
+      onDrop={
+        onDropNote
+          ? e => {
+              const taskId = e.dataTransfer.getData(NOTE_DRAG_MIME)
+              if (!taskId) return
+              e.preventDefault()
+              setDragOver(false)
+              onDropNote(taskId)
+            }
+          : undefined
+      }
+      className={`flex shrink-0 cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1 text-sm transition ${
+        dragOver
+          ? 'border-primary ring-primary/40 ring-2'
+          : active
+            ? 'border-primary bg-primary text-white'
+            : 'bg-white text-neutral-700 hover:border-neutral-400'
+      }`}
+    >
+      {label}
+      <span className={active ? 'text-white/80' : 'text-neutral-400'}>{count}</span>
+    </button>
+  )
+}
+
+function EmptyState({
+  loading,
+  offline,
+  searching,
+  keyword,
+  hasAnyNote,
+  onCreate,
+  onCreateFolder,
+  onRetry,
+}: {
+  loading: boolean
+  offline: boolean
+  searching: boolean
+  keyword: string
+  hasAnyNote: boolean
+  onCreate: () => void
+  onCreateFolder: () => void
+  onRetry: () => void
+}) {
+  if (loading) {
+    return <p className="text-muted-foreground py-20 text-center text-sm">正在读取笔记库…</p>
+  }
+  // 后端连不上时不能显示"还没有笔记"——那会让人以为笔记没了
+  if (offline) {
+    return (
+      <div className="flex flex-col items-center gap-3 py-20 text-center">
+        <p className="text-lg font-medium text-neutral-700">连不上笔记库</p>
+        <p className="text-muted-foreground max-w-md text-sm">
+          读不到后端的笔记索引。检查一下 Docker 容器是否在运行，然后重试。
+        </p>
+        <Button variant="outline" size="sm" onClick={onRetry}>
+          重试
+        </Button>
+      </div>
+    )
+  }
+  if (searching) {
+    return (
+      <p className="text-muted-foreground py-20 text-center text-sm">
+        没有匹配「{keyword}」的笔记
+      </p>
+    )
+  }
+  if (hasAnyNote) {
+    return (
+      <div className="text-muted-foreground py-16 text-center text-sm">
+        这里还没有笔记。把卡片拖进来归档，或者
+        <button type="button" onClick={onCreate} className="text-primary mx-1 cursor-pointer underline">
+          新建一篇
+        </button>
+        。
+      </div>
+    )
+  }
+  return (
+    <div className="flex flex-col items-center gap-4 py-20 text-center">
+      <p className="text-lg font-medium text-neutral-700">还没有笔记</p>
+      <p className="text-muted-foreground max-w-md text-sm">
+        粘贴 B 站 / YouTube / 抖音等视频链接，选一个笔记风格，AI 会把它整理成带目录、
+        可跳转原片、带板书截图的学习笔记。
+      </p>
+      <div className="flex gap-2">
+        <Button onClick={onCreate}>
+          <Plus className="h-4 w-4" />
+          新建笔记
+        </Button>
+        <Button variant="outline" onClick={onCreateFolder}>
+          <FolderPlus className="h-4 w-4" />
+          新建文件夹
+        </Button>
+      </div>
+    </div>
+  )
+}
+
+export default LibraryPage
