+
+class TestLinkifyTocMessyItems(unittest.TestCase):
+    """真实笔记里模型把目录条目写坏的两种样子，都要修成干净的单行链接。"""
+
+    def test_label_containing_nested_origin_link_is_cleaned(self):
+        markdown = (
+            "## 目录\n"
+            "- [二、基础公式 [原片 @ 00:08](https://x?t=8)](#二基础公式-content-0008)\n\n"
