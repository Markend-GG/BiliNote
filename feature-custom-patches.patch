+# 构建前端（与官方 Dockerfile.complete 一致的 node:20 + pnpm 9.15 环境，走国内镜像）
+FROM docker.m.daocloud.io/library/node:20-alpine AS ui
+ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
+RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
+WORKDIR /app
+COPY BillNote_frontend/package.json BillNote_frontend/pnpm-lock.yaml ./
+RUN pnpm install --frozen-lockfile
+COPY BillNote_frontend/ ./
+ENV DOCKER_BUILD=1
+RUN pnpm run build
+
+# 在 GPU 基础镜像上叠加：新前端构建产物 + 修补后的后端
+# （chat 贴图问答 / 公式渲染 / 笔记编辑保存 / Whisper 下载 / 截图相似去重 / 目录锚点与长视频时间戳修复）
+# 基础镜像 bilinote-gpu-base:local 由本仓库的 Dockerfile.gpu-base 构建（上游镜像 + CUDA torch + CUDA12 运行库）；
+# 两者必须是不同的 tag：以前 patch 直接 FROM bilinote-gpu:local 又打回同一个 tag，每次构建都往上叠一层，
+# 叠到第 5 次就撞上 Docker 的 127 层上限（docker run 报 "max depth exceeded"）。
+FROM bilinote-gpu-base:local
+# 禁用 HF 的 xet 传输协议（国内镜像/代理链路下经典 HTTP 下载更稳）
+ENV HF_HUB_DISABLE_XET=1
+# hub 0.30 实际只看 hf_xet 包是否存在（不读环境变量），必须卸载才能真正禁用
+RUN /usr/local/bin/pip uninstall -y hf-xet || true
+RUN rm -rf /usr/share/nginx/html && mkdir -p /usr/share/nginx/html
+COPY --from=ui /app/dist/ /usr/share/nginx/html/
+COPY backend/app/routers/chat.py /app/backend/app/routers/chat.py
+COPY backend/app/services/chat_service.py /app/backend/app/services/chat_service.py
+COPY backend/app/routers/note.py /app/backend/app/routers/note.py
+COPY backend/app/routers/config.py /app/backend/app/routers/config.py
+COPY backend/app/utils/image_dedup.py /app/backend/app/utils/image_dedup.py
+COPY backend/app/utils/video_reader.py /app/backend/app/utils/video_reader.py
+COPY backend/app/utils/screenshot_marker.py /app/backend/app/utils/screenshot_marker.py
+COPY backend/app/utils/note_helper.py /app/backend/app/utils/note_helper.py
+COPY backend/app/utils/markdown_toc.py /app/backend/app/utils/markdown_toc.py
+COPY backend/app/services/note.py /app/backend/app/services/note.py
+COPY backend/app/gpt/prompt_builder.py /app/backend/app/gpt/prompt_builder.py
+COPY backend/app/gpt/prompt.py /app/backend/app/gpt/prompt.py
+COPY backend/app/enmus/task_status_enums.py /app/backend/app/enmus/task_status_enums.py
+COPY backend/app/transcriber/whisper.py /app/backend/app/transcriber/whisper.py
+COPY backend/app/transcriber/transcriber_provider.py /app/backend/app/transcriber/transcriber_provider.py
+# 同步测试：上游的 test_video_reader_dedupe 写的是假字节，与感知去重不兼容，已重写
+COPY backend/tests/ /app/backend/tests/
