index f09d25d..9321c64 100644
--- a/backend/app/gpt/prompt.py
+++ b/backend/app/gpt/prompt.py
@@ -72,6 +72,8 @@ MERGE_PROMPT = '''
 你将收到多个来自同一视频的 Markdown 笔记片段，请合并成一份完整笔记：
 - 只做合并与去重，不要发明新内容
