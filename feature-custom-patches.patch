-            toast.error('未找到对应章节')
-          }
-        }
-
-        return (
-          <a
-            href={href}
-            onClick={handleAnchorClick}
-            className="text-primary hover:text-primary/80 inline-flex items-center gap-0.5 font-medium underline underline-offset-4"
-            {...props}
-          >
-            {children}
-          </a>
-        )
-      }
-
-      return (
-        <a
-          href={href}
-          target="_blank"
-          rel="noopener noreferrer"
-          className="text-primary hover:text-primary/80 inline-flex items-center gap-0.5 font-medium underline underline-offset-4"
