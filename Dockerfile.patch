# 构建前端（与官方 Dockerfile.complete 一致的 node:20 + pnpm 9.15 环境，走国内镜像）
FROM docker.m.daocloud.io/library/node:20-alpine AS ui
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY BillNote_frontend/package.json BillNote_frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY BillNote_frontend/ ./
ENV DOCKER_BUILD=1
# 类型门禁：vite build 走 esbuild 不查类型，曾经让一个 ReferenceError 溜到线上整页白屏。
# 存量债已清零（两个上游设置表单用 @ts-nocheck 豁免并记债），新代码不许再带类型错误进来
RUN pnpm run typecheck
RUN pnpm run build

# 在 GPU 基础镜像上叠加：新前端构建产物 + 修补后的后端
# （chat 贴图问答 / 公式渲染 / 笔记编辑保存 / Whisper 下载 / 截图相似去重 / 目录锚点与长视频时间戳修复
#   / 笔记库：文件夹收纳 + 书架页 + 真正生效的删除）
# 基础镜像 bilinote-gpu-base:local 由本仓库的 Dockerfile.gpu-base 构建（上游镜像 + CUDA torch + CUDA12 运行库）；
# 两者必须是不同的 tag：以前 patch 直接 FROM bilinote-gpu:local 又打回同一个 tag，每次构建都往上叠一层，
# 叠到第 5 次就撞上 Docker 的 127 层上限（docker run 报 "max depth exceeded"）。
FROM bilinote-gpu-base:local
# 禁用 HF 的 xet 传输协议（国内镜像/代理链路下经典 HTTP 下载更稳）
ENV HF_HUB_DISABLE_XET=1
# hub 0.30 实际只看 hf_xet 包是否存在（不读环境变量），必须卸载才能真正禁用
RUN /usr/local/bin/pip uninstall -y hf-xet || true
RUN rm -rf /usr/share/nginx/html && mkdir -p /usr/share/nginx/html
COPY --from=ui /app/dist/ /usr/share/nginx/html/
# 后端整目录同步，不再逐文件列清单。清单已经漏过一次：V3.2 新增的
# app/db/search_dao.py、app/routers/storage.py、app/services/note_index.py、
# app/utils/markdown_chunks.py 都没进镜像，容器一启动就 ImportError
# （init_db 要 search_dao、app/__init__ 要 routers.storage、routers/note 要 note_index）；
# 改过的 universal_gpt / vector_store / notes_model 没进镜像则是静默跑旧代码，更难发现。
# .dockerignore 已排除 __pycache__ / data / static / *.db，整目录 COPY 是安全的。
COPY backend/app/ /app/backend/app/
COPY backend/main.py /app/backend/main.py
COPY backend/tests/ /app/backend/tests/
# 日志轮转：上游 supervisord conf 没配 maxbytes/backups，backend.log 会无限涨。
# 必须覆盖成【同名】文件：基础镜像的 CMD 是
#   /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
# 写成别的名字（一度写成 bilinote.conf）CMD 就找不到配置文件，容器起来就退出、无限重启。
COPY deploy/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
# 启动命令显式写死，不赌基础镜像继承了什么
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
